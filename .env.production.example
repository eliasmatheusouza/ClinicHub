# Somente para validar docker compose config. Nunca use estes valores em deploy.
CLINICHUB_FRONTEND_IMAGE=ghcr.io/example/clinichub-frontend:replace-me
CLINICHUB_API_IMAGE=ghcr.io/example/clinichub-api:replace-me
CLINICHUB_WORKER_IMAGE=ghcr.io/example/clinichub-worker:replace-me
SQLSERVER_CONNECTION_STRING=Server=managed-sql.example;Database=ClinicHub;User Id=from-secret-manager;Password=replace-me;Encrypt=True
REDIS_CONNECTION_STRING=managed-redis.example:6380,ssl=True,password=replace-me
RABBITMQ_CONNECTION_STRING=amqps://from-secret-manager:replace-me@managed-rabbitmq.example:5671
API_ALLOWED_HOSTS=api.example.com
FRONTEND_ORIGIN=https://app.example.com
EMAIL_FROM=no-reply@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_USERNAME=from-secret-manager
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
EMAIL_SMTP_PASSWORD=replace-me
SEQ_SERVER_URL=https://seq.example.com
CLINICHUB_EDGE_NETWORK=clinichub-edge
